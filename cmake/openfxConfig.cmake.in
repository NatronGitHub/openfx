@PACKAGE_INIT@

# openfx CMake package: targets openfx::Api (C headers), openfx::HostSupport
# (libOfxHost) and openfx::Support (libOfxSupport), plus add_ofx_plugin().
# The compile definitions used to build the libraries (OFX_EXTENSIONS_*,
# OFX_SUPPORTS_*) are usage requirements of the library targets.
include(CMakeFindDependencyMacro)
set(_openfx_has_hostsupport @OFX_BUILD_HOSTSUPPORT@)
if(_openfx_has_hostsupport)
  # openfx::HostSupport links expat (ofxhPluginCache.h includes expat.h), at least the version it
  # was built with
  include("${CMAKE_CURRENT_LIST_DIR}/OpenFXExpat.cmake")
  ofx_find_expat(@OFX_EXPAT_VERSION@)
  if(NOT TARGET expat::expat)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "openfx::HostSupport needs expat >= @OFX_EXPAT_VERSION@")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    return()
  endif()
endif()
unset(_openfx_has_hostsupport)

include("${CMAKE_CURRENT_LIST_DIR}/openfxTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/OpenFX.cmake")
check_required_components(openfx)
